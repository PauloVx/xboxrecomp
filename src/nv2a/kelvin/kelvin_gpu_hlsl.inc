/* HLSL for the Kelvin D3D11 backend (kelvin_gpu.c includes this).
 *
 * The vertex stage here only places already-transformed vertices (the CPU
 * vertex programs run first, kelvin_vsh.c); the pixel stage is an interpreter
 * of the NV2A register combiners and texture stages with the same arithmetic
 * and ordering as kelvin_pixel.c: every input of a combiner stage is read
 * before any of its outputs is written.
 */
static const char kgpu_hlsl_common[] =
"#ifdef KG_FLAT\n"            /* flat shading: the colours come from a triangle's first vertex */
"#define KG_NI nointerpolation\n"
"#else\n"
"#define KG_NI\n"
"#endif\n"
"struct StageCfg {\n"
"    uint4  rgb_in;\n"
"    uint4  alpha_in;\n"
"    uint4  outs;\n"
"    float4 c0;\n"
"    float4 c1;\n"
"};\n"
"cbuffer PSConst : register(b0) {\n"
"    StageCfg stage[8];\n"
"    uint4  fin_abcd;\n"
"    uint4  fin_efg;\n"       /* x e, y f, z g, w flags */
"    float4 final_c0;\n"
"    float4 final_c1;\n"
"    float4 fogcolor;\n"
"    uint4  gen;\n"           /* x stages, y alpha func, z alpha ref, w unused */
"    uint4  texmode;\n"
"    uint4  texflags;\n"      /* bit0 valid, bit1 rect, bit2 alphakill, bits4-5 colorkey */
"    float4 texrcp[4];\n"
"    uint4  ckey;\n"
"    uint4  ckeymask;\n"
"    uint4  ofs;\n"           /* x: output alpha override (0 none, 1 force 1, 2 force 0) */
"};\n"
"cbuffer VSConst : register(b1) {\n"
"    float4 vs_scale;\n"      /* x 2/guestW, y 2/guestH, z 1/zmax, w w-normalise factor */
"    uint4  vs_rec0;\n"       /* x base, y stride, z pos slot, w d0 slot */
"    uint4  vs_rec1;\n"       /* x d1 slot, y fog slot, z t0 slot, w t1 slot */
"    uint4  vs_rec2;\n"       /* x t2 slot, y t3 slot, z..w unused */
"    float4 vs_misc;\n"
"};\n"
"struct VSOut {\n"
"    float4 pos : SV_Position;\n"
"    KG_NI float4 d0  : TEXCOORD0;\n"
"    KG_NI float4 d1  : TEXCOORD1;\n"
"    float4 misc: TEXCOORD2;\n"
"    float4 t0  : TEXCOORD3;\n"
"    float4 t1  : TEXCOORD4;\n"
"    float4 t2  : TEXCOORD5;\n"
"    float4 t3  : TEXCOORD6;\n"
"};\n";

static const char kgpu_hlsl_vs[] =
"Buffer<float4> VB : register(t8);\n"
"float4 FetchRec(uint base, uint slot, float4 dflt) {\n"
"    return slot == 0xFFFFFFFFu ? dflt : VB[base + slot];\n"
"}\n"
"VSOut vs_main(uint vid : SV_VertexID) {\n"
"    VSOut o;\n"
"    uint base = vs_rec0.x + vid * vs_rec0.y;\n"
"    float4 p = VB[base + vs_rec0.z];\n"
"    float w = p.w;\n"
"    if (abs(w) < 1.0e-12) w *= vs_scale.w;\n"
"    float2 ndc = float2(p.x * vs_scale.x - 1.0, 1.0 - p.y * vs_scale.y);\n"
"    float zn = p.z * vs_scale.z;\n"
"    o.pos = float4(ndc * w, zn * w, w);\n"
"    o.d0 = FetchRec(base, vs_rec0.w, float4(0,0,0,1));\n"
"    o.d1 = FetchRec(base, vs_rec1.x, float4(0,0,0,1));\n"
"    float4 f = FetchRec(base, vs_rec1.y, float4(1,0,0,0));\n"
"    o.misc = f;\n"
"    o.t0 = FetchRec(base, vs_rec1.z, float4(0,0,0,1));\n"
"    o.t1 = FetchRec(base, vs_rec1.w, float4(0,0,0,1));\n"
"    o.t2 = FetchRec(base, vs_rec2.x, float4(0,0,0,1));\n"
"    o.t3 = FetchRec(base, vs_rec2.y, float4(0,0,0,1));\n"
"    return o;\n"
"}\n";

static const char kgpu_hlsl_ps[] =
"Texture2D<float4> Tex0 : register(t0);\n"
"Texture2D<float4> Tex1 : register(t1);\n"
"Texture2D<float4> Tex2 : register(t2);\n"
"Texture2D<float4> Tex3 : register(t3);\n"
"SamplerState Smp0 : register(s0);\n"
"SamplerState Smp1 : register(s1);\n"
"SamplerState Smp2 : register(s2);\n"
"SamplerState Smp3 : register(s3);\n"
"\n"
"float3 map3(float3 x, uint mod) {\n"
"    if (mod == 0x00u) return max(x, 0.0);\n"
"    if (mod == 0x20u) return 1.0 - clamp(x, 0.0, 1.0);\n"
"    if (mod == 0x40u) return 2.0 * max(x, 0.0) - 1.0;\n"
"    if (mod == 0x60u) return -2.0 * max(x, 0.0) + 1.0;\n"
"    if (mod == 0x80u) return max(x, 0.0) - 0.5;\n"
"    if (mod == 0xA0u) return -max(x, 0.0) + 0.5;\n"
"    if (mod == 0xE0u) return -x;\n"
"    return x;\n"
"}\n"
"float map1(float x, uint mod) {\n"
"    return map3(float3(x, x, x), mod).x;\n"
"}\n"
"float3 mapout3(float3 x, uint m) {\n"
"    if (m == 0x08u) return x - 0.5;\n"
"    if (m == 0x10u) return x * 2.0;\n"
"    if (m == 0x18u) return (x - 0.5) * 2.0;\n"
"    if (m == 0x20u) return x * 4.0;\n"
"    if (m == 0x30u) return x * 0.5;\n"
"    return x;\n"
"}\n"
"float mapout1(float x, uint m) { return mapout3(float3(x, x, x), m).x; }\n"
"float3 clamp1_3(float3 x) { return clamp(x, -1.0, 1.0); }\n"
"float clamp1_1(float x) { return clamp(x, -1.0, 1.0); }\n"
"\n"
"bool Writable(uint r) { return r == 4u || r == 5u || (r >= 8u && r <= 13u); }\n"
"\n"
"float4 ps_main(VSOut v) : SV_Target {\n"
"    float4 R[16];\n"
"    float4 T[4];\n"
"    bool killed = false;\n"
"    float4 vt[4] = { v.t0, v.t1, v.t2, v.t3 };\n"
"    float4 rcp[4] = { texrcp[0], texrcp[1], texrcp[2], texrcp[3] };\n"
"    float4 s0, s1, s2, s3;\n"
"    {\n"
"        float2 uv0 = float2(0.0, 0.0); float2 uv1 = uv0; float2 uv2 = uv0; float2 uv3 = uv0;\n"
"        if (vt[0].w != 0.0) uv0 = vt[0].xy / vt[0].w;\n"
"        if (vt[1].w != 0.0) uv1 = vt[1].xy / vt[1].w;\n"
"        if (vt[2].w != 0.0) uv2 = vt[2].xy / vt[2].w;\n"
"        if (vt[3].w != 0.0) uv3 = vt[3].xy / vt[3].w;\n"
"        if (texflags.x & 2u) uv0 *= rcp[0].xy;\n"
"        if (texflags.y & 2u) uv1 *= rcp[1].xy;\n"
"        if (texflags.z & 2u) uv2 *= rcp[2].xy;\n"
"        if (texflags.w & 2u) uv3 *= rcp[3].xy;\n"
"        s0 = Tex0.Sample(Smp0, uv0);\n"
"        s1 = Tex1.Sample(Smp1, uv1);\n"
"        s2 = Tex2.Sample(Smp2, uv2);\n"
"        s3 = Tex3.Sample(Smp3, uv3);\n"
"    }\n"
"    float4 samp[4] = { s0, s1, s2, s3 };\n"
"    [unroll] for (uint ti = 0; ti < 4; ti++) {\n"
"        float4 t = float4(0.0, 0.0, 0.0, 1.0);\n"
"        uint mode = ti == 0 ? texmode.x : ti == 1 ? texmode.y : ti == 2 ? texmode.z : texmode.w;\n"
"        uint fl = ti == 0 ? texflags.x : ti == 1 ? texflags.y : ti == 2 ? texflags.z : texflags.w;\n"
"        uint key = ti == 0 ? ckey.x : ti == 1 ? ckey.y : ti == 2 ? ckey.z : ckey.w;\n"
"        uint kmask = ti == 0 ? ckeymask.x : ti == 1 ? ckeymask.y : ti == 2 ? ckeymask.z : ckeymask.w;\n"
"        if (mode == 1u && (fl & 1u) != 0u && vt[ti].w != 0.0) {\n"
"            t = samp[ti];\n"
"            if ((fl & 4u) != 0u && t.a == 0.0) killed = true;\n"
"            uint ckm = (fl >> 4) & 3u;\n"
"            if (ckm != 0u) {\n"
"                uint4 q = (uint4)(saturate(t) * 255.0 + 0.5);\n"
"                uint c = (q.a << 24) | (q.r << 16) | (q.g << 8) | q.b;\n"
"                if ((c & kmask) == (key & kmask)) {\n"
"                    if (ckm == 3u) killed = true;\n"
"                    else if (ckm == 1u) t.a = 0.0;\n"
"                    else t = float4(0.0, 0.0, 0.0, 0.0);\n"
"                }\n"
"            }\n"
"        } else if (mode == 1u) {\n"
"            t = float4(0.0, 0.0, 0.0, 1.0);\n"
"        }\n"
"        T[ti] = t;\n"
"    }\n"
"    if (killed) discard;\n"
"\n"
"    uint fflags = fin_efg.w;\n"
"    R[0] = float4(0, 0, 0, 0);\n"
"    R[1] = stage[0].c0;\n"
"    R[2] = stage[0].c1;\n"
"    R[3] = float4(fogcolor.rgb, saturate(v.misc.x));\n"
"    R[4] = v.d0;\n"
"    R[5] = v.d1;\n"
"    R[6] = float4(0, 0, 0, 0);\n"
"    R[7] = float4(0, 0, 0, 0);\n"
"    R[8] = T[0]; R[9] = T[1]; R[10] = T[2]; R[11] = T[3];\n"
"    R[12] = float4(0.0, 0.0, 0.0, texmode.x != 0u ? T[0].a : 1.0);\n"
"    R[13] = float4(0, 0, 0, 0);\n"
"    R[14] = float4(0, 0, 0, 0);\n"
"    R[15] = float4(0, 0, 0, 0);\n"
"\n"
"    uint nst = gen.x;\n"
"    [loop] for (uint i = 0; i < nst; i++) {\n"
"        StageCfg s = stage[i];\n"
"        if (fflags & 0x20u) R[1] = s.c0; else R[1] = stage[0].c0;\n"
"        if (fflags & 0x40u) R[2] = s.c1; else R[2] = stage[0].c1;\n"
"        {\n"
"            float3 a1 = (fflags & 4u) ? 1.0 - R[5].rgb : R[5].rgb;\n"
"            float3 b1 = (fflags & 8u) ? 1.0 - R[12].rgb : R[12].rgb;\n"
"            float3 sm = a1 + b1;\n"
"            if (fflags & 2u) sm = clamp(sm, 0.0, 1.0);\n"
"            R[14] = float4(sm, 0.0);\n"
"        }\n"
"        float3 ra[4];\n"
"        float  aa[4];\n"
"        uint   rin[4] = { s.rgb_in.x, s.rgb_in.y, s.rgb_in.z, s.rgb_in.w };\n"
"        uint   ain[4] = { s.alpha_in.x, s.alpha_in.y, s.alpha_in.z, s.alpha_in.w };\n"
"        [unroll] for (uint k = 0; k < 4; k++) {\n"
"            float4 rv = R[rin[k] & 15u];\n"
"            ra[k] = (rin[k] & 0x10u) ? map3(rv.aaa, rin[k] & 0xE0u) : map3(rv.rgb, rin[k] & 0xE0u);\n"
"            float4 av = R[ain[k] & 15u];\n"
"            aa[k] = map1((ain[k] & 0x10u) ? av.a : av.b, ain[k] & 0xE0u);\n"
"        }\n"
"        uint ro = s.outs.x;\n"
"        uint rcd = ro & 15u, rab = (ro >> 4) & 15u, rmx = (ro >> 8) & 15u, rfl = ro >> 12;\n"
"        uint rmap = rfl & 0x38u;\n"
"        float3 ab3 = (rfl & 2u) ? dot(ra[0], ra[1]).xxx : ra[0] * ra[1];\n"
"        float3 cd3 = (rfl & 1u) ? dot(ra[2], ra[3]).xxx : ra[2] * ra[3];\n"
"        bool selr = ((fflags & 0x10u) != 0u) ? (R[12].a >= 0.5) : ((((uint)(R[12].a * 255.0)) & 1u) == 1u);\n"
"        float3 mx3 = (rfl & 4u) ? (selr ? cd3 : ab3) : (ab3 + cd3);\n"
"        float3 rab3 = clamp1_3(mapout3(ab3, rmap));\n"
"        float3 rcd3 = clamp1_3(mapout3(cd3, rmap));\n"
"        float3 rmx3 = clamp1_3(mapout3(mx3, rmap));\n"
"        uint ao = s.outs.y;\n"
"        uint acd = ao & 15u, aab = (ao >> 4) & 15u, amx = (ao >> 8) & 15u, afl = ao >> 12;\n"
"        uint amap = afl & 0x38u;\n"
"        float ab1 = aa[0] * aa[1];\n"
"        float cd1 = aa[2] * aa[3];\n"
"        float mx1 = (afl & 4u) ? (selr ? cd1 : ab1) : (ab1 + cd1);\n"
"        float rab1 = clamp1_1(mapout1(ab1, amap));\n"
"        float rcd1 = clamp1_1(mapout1(cd1, amap));\n"
"        float rmx1 = clamp1_1(mapout1(mx1, amap));\n"
"        // writes: RGB portion (ab, cd, mux) then alpha portion\n"
"        if (Writable(rab)) { R[rab].rgb = rab3; if (rfl & 0x80u) R[rab].a = rab3.b; }\n"
"        if (Writable(rcd)) { R[rcd].rgb = rcd3; if (rfl & 0x40u) R[rcd].a = rcd3.b; }\n"
"        if (Writable(rmx)) { R[rmx].rgb = rmx3; }\n"
"        if (Writable(aab)) { R[aab].a = rab1; }\n"
"        if (Writable(acd)) { R[acd].a = rcd1; }\n"
"        if (Writable(amx)) { R[amx].a = rmx1; }\n"
"    }\n"
"\n"
"    float4 frag;\n"
"    if (fflags & 1u) {\n"
"        R[1] = final_c0;\n"
"        R[2] = final_c1;\n"
"        {\n"
"            float3 a1 = (fflags & 4u) ? 1.0 - R[5].rgb : R[5].rgb;\n"
"            float3 b1 = (fflags & 8u) ? 1.0 - R[12].rgb : R[12].rgb;\n"
"            float3 sm = a1 + b1;\n"
"            if (fflags & 2u) sm = clamp(sm, 0.0, 1.0);\n"
"            R[14] = float4(sm, 0.0);\n"
"        }\n"
"        uint ine = fin_efg.x, inf = fin_efg.y, ing = fin_efg.z;\n"
"        float4 ev = R[ine & 15u], fv = R[inf & 15u];\n"
"        float3 e3 = (ine & 0x10u) ? map3(ev.aaa, ine & 0xE0u) : map3(ev.rgb, ine & 0xE0u);\n"
"        float3 f3 = (inf & 0x10u) ? map3(fv.aaa, inf & 0xE0u) : map3(fv.rgb, inf & 0xE0u);\n"
"        R[15] = float4(e3 * f3, 0.0);\n"
"        uint fa = fin_abcd.x, fb = fin_abcd.y, fc = fin_abcd.z, fd = fin_abcd.w;\n"
"        float4 av = R[fa & 15u], bv = R[fb & 15u], cv = R[fc & 15u], dv = R[fd & 15u];\n"
"        float3 a3 = (fa & 0x10u) ? map3(av.aaa, fa & 0xE0u) : map3(av.rgb, fa & 0xE0u);\n"
"        float3 b3 = (fb & 0x10u) ? map3(bv.aaa, fb & 0xE0u) : map3(bv.rgb, fb & 0xE0u);\n"
"        float3 c3 = (fc & 0x10u) ? map3(cv.aaa, fc & 0xE0u) : map3(cv.rgb, fc & 0xE0u);\n"
"        float3 d3 = (fd & 0x10u) ? map3(dv.aaa, fd & 0xE0u) : map3(dv.rgb, fd & 0xE0u);\n"
"        float4 gv = R[ing & 15u];\n"
"        float g1 = map1((ing & 0x10u) ? gv.a : gv.b, ing & 0xE0u);\n"
"        frag = float4(d3 + c3 * (1.0 - a3) + b3 * a3, g1);\n"
"    } else {\n"
"        frag = R[12];\n"
"    }\n"
"\n"
"    uint func = gen.y;\n"
"    if (func != 7u) {\n"
"        int fa = (int)floor(frag.a * 255.0 + 0.5);\n"
"        int ref = (int)gen.z;\n"
"        bool apass = true;\n"
"        if (func == 0u) apass = false;\n"
"        else if (func == 1u) apass = fa < ref;\n"
"        else if (func == 2u) apass = fa == ref;\n"
"        else if (func == 3u) apass = fa <= ref;\n"
"        else if (func == 4u) apass = fa > ref;\n"
"        else if (func == 5u) apass = fa != ref;\n"
"        else if (func == 6u) apass = fa >= ref;\n"
"        if (!apass) discard;\n"
"    }\n"
"    float4 o = saturate(frag);\n"
"    if (ofs.x == 1u) o.a = 1.0; else if (ofs.x == 2u) o.a = 0.0;\n"
"    return o;\n"
"}\n";
